# Used only by `npm run dev`.
# Live backend: /api is proxied by vite.config.ts to this URL (keep VITE_API_URL empty).
VITE_API_PROXY=https://acharbackend.vercel.app

# Local backend (Acharbackend, `npm run dev` on port 5000): uncomment and comment out the line above.
# VITE_API_PROXY=http://localhost:5000

VITE_SITE_URL=http://localhost:5173
