{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://acharbackend.vercel.app/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://acharbackend.vercel.app/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://acharbackend.vercel.app/robots.txt" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
