# Base URL of the backend API.
# Leave empty when the website host rewrites /api/* to the backend (recommended; see README).
# Otherwise set the full URL, e.g. https://api.acharika.in
VITE_API_URL=

# Public URL of this website (no trailing slash). Used for canonical links and SEO structured data.
# e.g. https://www.acharika.in
VITE_SITE_URL=
